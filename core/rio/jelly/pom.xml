	</parent>
	<artifactId>rdf4j-rio-jelly</artifactId>
	<name>RDF4J: Rio - Jelly</name>
	<description>Rio parser and writer implementation for the Jelly-RDF file format.</description>
	<dependencies>
		<dependency>
			<groupId>eu.neverblink.jelly</groupId>
			<artifactId>jelly-rdf4j</artifactId>
			<version>3.5.2+13-60c1f0c3+20250927-1833-SNAPSHOT</version>
			<exclusions>
